        "operation": "executeQuery",
        "query": "INSERT INTO sprint_velocity (sprint_id, sprint_name, project_id, points_completed, sprint_start_date, sprint_end_date)\nVALUES ($1, $2, $3, $4, $5, $6)\nON CONFLICT (sprint_id, project_id) DO UPDATE SET\n  points_completed = EXCLUDED.points_completed;",
