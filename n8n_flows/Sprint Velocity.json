      "parameters": {
        "jsCode": "const sprints = $(\"Get Project Milestones\").all();\nconst resultsArray = [];\n\nconst project_id = $('Merge').first().json.project_id\n\nfor (const item of sprints) {\n  const sprint = item.json;\n\n  const sprintData = {\n    sprint_id: sprint.id,\n    sprint_name: sprint.name,\n    project_id: Number(project_id),\n    points_completed: sprint.closed_points || 0,\n    sprint_start_date: sprint.estimated_start,\n    sprint_end_date: sprint.estimated_finish\n  };\n\n  resultsArray.push(sprintData);\n}\n\nreturn resultsArray.map(sprintData => ({ json: sprintData }));"
      },
