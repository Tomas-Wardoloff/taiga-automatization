      "parameters": {
        "jsCode": "const sprints = $input.all(); \nconst resultsArray = [];\n\nfor (const item of sprints) {\n  const sprint = item.json;\n\n  const sprintData = {\n    sprint_id: sprint.id,\n    sprint_name: sprint.name,\n    project_id: sprint.project,\n    points_completed: sprint.closed_points || 0,\n    sprint_start_date: sprint.estimated_start,\n    sprint_end_date: sprint.estimated_finish\n  };\n\n  resultsArray.push(sprintData);\n}\n\nreturn resultsArray.map(sprintData => ({ json: sprintData }));"
